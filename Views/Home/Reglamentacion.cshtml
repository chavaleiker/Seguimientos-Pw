@model Actividad.Models.Jugador
@{
    ViewData["Title"] = "Reglamentación del torneo";
}

<section class="py-5" id="informacion">
    <div class="container">

        <div class="text-center mb-4">
            <h2 class="section-title">Información del torneo</h2>
            <p class="text-muted">Todo lo necesario para participar.</p>
        </div>

        <div class="row g-4">

            <div class="col-12 col-md-4">
                <article class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5 card-title">Características</h3>
                        <ul>
                            <li>Participación abierta a estudiantes.</li>
                            <li>Partidos individuales.</li>
                            <li>Competencia organizada por rondas.</li>
                            <li>Clasificación mediante puntos.</li>
                            <li>Premiación para los primeros puestos.</li>
                        </ul>
                    </div>
                </article>
            </div>

            <div class="col-12 col-md-4">
                <article class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5 card-title">Pasos para participar</h3>
                        <ol>
                            <li>Realizar el registro.</li>
                            <li>Consultar la programación.</li>
                            <li>Presentarse antes de la hora asignada.</li>
                            <li>Respetar las reglas del torneo.</li>
                        </ol>
                    </div>
                </article>
            </div>

            <div class="col-12 col-md-4">
                <article class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <h3 class="h5 card-title">Reglas básicas</h3>
                        <ul class="text-start">
                            <li>Respetar al rival y al árbitro.</li>
                            <li>Utilizar una pala reglamentaria.</li>
                            <li>Esperar el turno para jugar.</li>
                            <li>Aceptar las decisiones arbitrales.</li>
                        </ul>
                    </div>
                </article>
            </div>

        </div>
    </div>
</section>

<section id="reglamento" class="py-5 bg-light">
    <div class="container">

        <div class="row g-4 align-items-center">

            <div class="col-12 col-md-8">
                <h2 class="section-title">Reglamento oficial</h2>

                <p>
                    Para garantizar una competencia justa, todos los jugadores
                    deben conocer y respetar las reglas del tenis de mesa,
                    incluyendo el saque, la puntuación y el comportamiento
                    durante los partidos.
                </p>

                <div class="d-flex flex-column flex-sm-row gap-2">

                    <a class="btn btn-outline-primary"
                       href="https://www.mindeporte.gov.co/files/a08e366e-ef77-4ed1-907c-997453e4d436/a08e45f5-e571-4b21-8a2e-88bde72e77e6/Reglamento-tenis-mesa-JDFP-2025.pdf"
                       target="_blank"
                       rel="noopener noreferrer">
                        Consultar reglamento oficial
                    </a>

                    <a class="btn btn-outline-secondary"
                       href="https://www.youtube.com/watch?v=uAcTaNooll0"
                       target="_blank"
                       rel="noopener noreferrer">
                        Ver explicación
                    </a>

                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="alert alert-warning mb-0">
                    <strong>Importante:</strong>
                    consulta las reglas antes de participar y llega
                    puntualmente a tus partidos.
                </div>
            </div>

        </div>
    </div>
</section>
