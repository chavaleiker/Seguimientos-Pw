@model Actividad.Models.Jugador

@{
    ViewData["Title"] = "Torneo de Tenis de Mesa";

    var jugadores = ViewBag.Jugadores as List<Actividad.Models.Jugador>
                    ?? new List<Actividad.Models.Jugador>();
}



<section class="py-5" id="inicio">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-12">
                <div class="card border-0 shadow p-4 p-md-5"
                     style="background-color: #33432B; border-radius: 24px;">

                    <h1 class="section-title text-white fw-bold">
                        Torneo de Tenis de Mesa IUE
                    </h1>

                    <p class="text-white mb-4">
                        Inscríbete y demuestra tus habilidades en la mesa.
                        Participa en el torneo y pon a prueba tu nivel de juego.
                    </p>

                    <div>
                        <a class="btn btn-light rounded-pill px-4"
                           href="#registro">
                            Inscribirme
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>


<div class="container my-5">

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    <div class="row g-4">

        <div class="col-lg-5" id="registro">
            <div class="card shadow p-4">
                <h2>Inscripción de jugadores</h2>

                <form asp-controller="Jugadores" asp-action="Index" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">
                            Nombre completo
                        </label>
                        <input asp-for="Nombre"
                               class="form-control"
                               placeholder="Ingresa tu nombre" />
                        <span asp-validation-for="Nombre"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label">
                            Correo electrónico
                        </label>
                        <input asp-for="Correo"
                               type="email"
                               class="form-control"
                               placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Correo"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Edad" class="form-label">
                            Edad
                        </label>
                        <input asp-for="Edad"
                               type="number"
                               class="form-control"
                               min="8"
                               max="100" />
                        <span asp-validation-for="Edad"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Categoria" class="form-label">
                            Categoría
                        </label>
                        <select asp-for="Categoria" class="form-select">
                            <option value="">Selecciona una categoría</option>
                            <option value="Principiante">Principiante</option>
                            <option value="Intermedio">Intermedio</option>
                            <option value="Avanzado">Avanzado</option>
                        </select>
                        <span asp-validation-for="Categoria"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Nivel" class="form-label">
                            Nivel de juego
                        </label>
                        <select asp-for="Nivel" class="form-select">
                            <option value="">Selecciona tu nivel</option>
                            <option value="Aficionado">Aficionado</option>
                            <option value="Competitivo">Competitivo</option>
                        </select>
                        <span asp-validation-for="Nivel"
                              class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-success w-100">
                        Registrar jugador
                    </button>
                </form>
            </div>
        </div>

        <div class="col-lg-7" id="jugadores">
            <h2>Jugadores inscritos</h2>

            <p>
                Total de jugadores:
                <strong>@jugadores.Count</strong>
            </p>

            @if (jugadores.Count == 0)
            {
                <div class="alert alert-info">
                    Todavía no hay jugadores inscritos.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>Edad</th>
                                <th>Categoría</th>
                                <th>Nivel</th>
                                <th>Acción</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var jugador in jugadores)
                            {
                                <tr>
                                    <td>
                                        @jugador.Nombre
                                        <div class="small text-muted">
                                            @jugador.Correo
                                        </div>
                                    </td>
                                    <td>@jugador.Edad</td>
                                    <td>@jugador.Categoria</td>
                                    <td>@jugador.Nivel</td>
                                    <td>
                                        <form asp-controller="Jugadores"
                                            asp-action="Eliminar"
                                            method="post"
                                            onsubmit="return confirm('¿Eliminar este jugador?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@jugador.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm">
                                                Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
</div>